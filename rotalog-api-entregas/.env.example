# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=rotalog
DB_USER=rotalog_admin
DB_PASSWORD=CHANGE_ME
DB_SCHEMA=entregas

# Auth: enforce | report | off  (off is refused when NODE_ENV=production; default is enforce)
AUTH_MODE=off
# Minimum 32 bytes. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME_min_32_bytes
JWT_ISSUER=rotalog
JWT_AUDIENCE=rotalog-api-entregas
JWT_ALGORITHMS=HS256

API_FROTAS_URL=http://localhost:8080/api
API_NOTIFICACOES_URL=http://localhost:5000
